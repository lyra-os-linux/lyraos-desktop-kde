{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/lyra-os/fastfetch/logo.txt",
    "padding": { "right": 3 },
    "color": {
      "1": "38;2;231;237;246",
      "2": "38;2;59;130;246",
      "3": "38;2;139;92;246"
    }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "cyan" }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "command",
      "key": "OS",
      "text": "if [ -r /etc/os-release ]; then . /etc/os-release; name=${NAME:-${PRETTY_NAME:-Linux}}; version=${VERSION_ID:-${VERSION:-}}; printf '%s' \"$name\"; [ -n \"$version\" ] && printf ' %s' \"$version\"; printf '\\n'; else printf '%s\\n' 'Unknown'; fi"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "colors"
  ]
}
