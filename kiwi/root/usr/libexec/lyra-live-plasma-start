#!/bin/sh
set -u

# A fast first Plasma login can start the layout before KWin has announced an
# output. This happens both with live autologin and with the first user login
# after installation, leaving the panel detached and the wallpaper blank.
# Wait for a real enabled output before resetting each pristine user profile.
state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/lyra-os"
state_file="$state_dir/plasma-initialized"

if [ ! -e "$state_file" ]; then
    attempt=0
    while [ "$attempt" -lt 60 ]; do
        if /usr/bin/kscreen-doctor -o 2>/dev/null | grep -Eq '^Output:.*enabled'; then
            break
        fi
        attempt=$((attempt + 1))
        sleep 0.25
    done

    # Apply Lyra's dark Breeze default with its stock panel only after screen
    # discovery, then brand the wallpaper without replacing the layout itself.
    /usr/bin/lookandfeeltool -a org.kde.breezedark.desktop --resetLayout || true
    /usr/bin/plasma-apply-wallpaperimage \
        /usr/share/backgrounds/lyra/2702-dawn.png || true
    mkdir -p "$state_dir"
    : > "$state_file"
fi
